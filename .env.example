# Red Bricks Property Management - Environment Configuration Template

# Server & Environment
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=redbrick_records.db

# RentVine MCP Endpoint & Credentials
# Official MCP documentation: https://www.rentvine.com/features/mcp/setup
RENTVINE_MCP_ENDPOINT=https://mcp.rentvine.ai/mcp
RENTVINE_API_KEY=rv_live_demo_key_redbrick_2026
RENTVINE_MOCK_MODE=true

# Quo (OpenPhone) SMS Integration
# Official integration docs: https://www.quo.com/integrations/chatgpt
QUO_API_URL=https://api.openphone.com/v1
QUO_API_KEY=quo_live_secret_redbrick_9942
# 1. Tenants & Vendors (Rent reminders & payment follow-ups): (980) 300-7559 -> PNnMjdTFVO
QUO_DEFAULT_PHONE_NUMBER_ID=PNnMjdTFVO
QUO_PHONE_NUMBER_TENANTS=PNnMjdTFVO
# 2. Landlords (Landlord updates & communications): (980) 300-1196 -> PNTDARdwBh
QUO_PHONE_NUMBER_LANDLORDS=PNTDARdwBh
# 3. Primary (General inbox - isolated): (667) 281-3879 -> PNz3t43PKv
QUO_PHONE_NUMBER_PRIMARY=PNz3t43PKv
QUO_MOCK_MODE=true

# Gmail API (OAuth 2.0)
GMAIL_CLIENT_ID=redbrick-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-redbrick-mock-secret
GMAIL_INBOX_LABEL=INBOX
GMAIL_MOCK_MODE=true

# AI Intent Classifier Engine (Claude Sonnet 3.5, OpenAI, or Groq)
# Paste your Anthropic / Claude API Key (starts with sk-ant-api03-...)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
AI_CONFIDENCE_THRESHOLD=0.75

# Optional alternative providers:
GROQ_API_KEY=
OPENAI_API_KEY=

# Business Rules Engine Parameters
GRACE_PERIOD_DAYS=3
DEDUPLICATION_WINDOW_HOURS=24
PROMISE_EXPIRY_DAYS=5
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=300
